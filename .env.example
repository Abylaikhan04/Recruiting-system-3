# RecruitFlow project env (used by docker-compose)
APP_ENV=local
APP_DEBUG=true
APP_PORT=80
APP_URL=http://localhost
FRONTEND_URL=http://localhost
VITE_API_URL=/api
DB_DATABASE=recruitflow
DB_USERNAME=recruitflow
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ── Продакшен (docker-compose.prod.yml) ──────────────────────────────────
# Реальный домен компании, без схемы и без слэша — нужен для HTTPS/certbot.
# DOMAIN=recruitflow.company.kz
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://recruitflow.company.kz
# FRONTEND_URL=https://recruitflow.company.kz
# VITE_API_URL=https://recruitflow.company.kz/api
# Email для уведомлений Let's Encrypt об истечении сертификата (certbot certonly --email)
# CERTBOT_EMAIL=devops@company.kz
# Сколько дней хранить бэкапы Postgres (сервис backup в docker-compose.prod.yml)
# BACKUP_RETENTION_DAYS=14
